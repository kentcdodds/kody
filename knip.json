{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"include": ["files"],
	"workspaces": {
		".": {
			"entry": [
				"tools/**/*.{ts,js,mjs}",
				"e2e/**/*.ts",
				"vitest*.ts",
				"vite.config.ts"
			],
			"project": ["tools/**/*.{ts,js,mjs}", "*.ts", "e2e/**/*.ts"]
		},
		"packages/worker": {
			"entry": [
				"client/entry.tsx",
				"src/mcp/capabilities/**/*.ts",
				"src/mcp/instructions/**/*.ts"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"client/**/*.{ts,tsx}",
				"universal/**/*.{ts,tsx}"
			]
		},
		"packages/jobs-worker": {
			"project": ["src/**/*.ts"]
		},
		"packages/highlight-worker": {
			"project": ["src/**/*.ts"]
		},
		"packages/backup-control-plane": {
			"project": ["*.ts"]
		},
		"packages/status": {
			"project": ["*.ts"]
		},
		"packages/nx-cache": {
			"entry": ["smoke-probe.ts"],
			"project": ["*.ts"]
		},
		"packages/shared": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/mock-servers/cloudflare": {
			"project": ["src/**/*.ts"]
		}
	}
}
