{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"workspaceLayout": {
		"libsDir": "packages"
	},
	"namedInputs": {
		"sharedGlobals": [
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/package-lock.json",
			"{workspaceRoot}/tsconfig*.json",
			{
				"env": "CI"
			}
		],
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"workspace": [
			"{workspaceRoot}/**/*",
			"{workspaceRoot}/.agents/**/*",
			"{workspaceRoot}/.github/**/*",
			{
				"env": "CI"
			}
		],
		"suiteSupport": [
			"{workspaceRoot}/vitest*.ts",
			"{workspaceRoot}/vite.config.ts",
			"{workspaceRoot}/wrangler-env.ts",
			"{workspaceRoot}/tools/**/*",
			"{workspaceRoot}/docs/**/*",
			"{workspaceRoot}/packages/mock-servers/**/*",
			"{workspaceRoot}/packages/jobs-worker/**/*",
			"{workspaceRoot}/packages/highlight-worker/**/*",
			"{workspaceRoot}/packages/shared/**/*",
			"{workspaceRoot}/skills-lock.json",
			"{workspaceRoot}/.agents/**/*"
		]
	},
	"targetDefaults": {
		"build": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/docs/guides/**/*",
				"{workspaceRoot}/tools/**/*",
				"{workspaceRoot}/vite.config.ts",
				"{workspaceRoot}/wrangler-env.ts"
			]
		},
		"typecheck": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/packages/mock-servers/**/*"
			]
		},
		"test": {
			"cache": true,
			"inputs": ["workspace"]
		},
		"test-node": {
			"cache": true,
			"inputs": ["workspace"]
		},
		"test-workers": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				{
					"env": "KODY_VALIDATE_LOAD"
				},
				"suiteSupport"
			]
		},
		"test-mcp": {
			"cache": true,
			"inputs": ["default", "^default", "suiteSupport"]
		},
		"prepare-e2e-env": {
			"cache": true
		},
		"prepare-playwright": {
			"cache": false
		},
		"test-e2e": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"suiteSupport",
				"{workspaceRoot}/e2e/**/*",
				"{workspaceRoot}/playwright.config.ts"
			]
		},
		"dev": {
			"cache": false
		},
		"dev-client": {
			"cache": false
		},
		"dev-worker": {
			"cache": false
		},
		"preview": {
			"cache": false
		},
		"preview-e2e": {
			"cache": false
		}
	},
	"tui": {
		"enabled": false
	},
	"neverConnectToCloud": true,
	"analytics": false
}
