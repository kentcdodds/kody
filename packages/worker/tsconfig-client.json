{
	"extends": "@epic-web/config/typescript",
	"compilerOptions": {
		"composite": true,
		"allowImportingTsExtensions": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.client.tsbuildinfo",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": [],
		"jsx": "react-jsx",
		"jsxImportSource": "remix/ui",
		"baseUrl": ".",
		"paths": {
			"#app/*": ["./src/app/*"],
			"#client/*": ["./client/*"],
			"#worker/*": ["./src/*"]
		}
	},
	"include": [
		"./client/**/*.ts",
		"./client/**/*.tsx",
		"./client/**/*.d.ts",
		"./src/app/oauth-login-errors.ts",
		"./src/app/permissions.ts",
		"./src/app/routes.ts",
		"./src/app/frame-constants.ts",
		"./src/app/community-frame-constants.ts",
		"./src/app/profile-frame-constants.ts",
		"./src/app/community-listing-icon.tsx",
		"./src/app/user-avatar.tsx",
		"./src/app/community-public-types.ts",
		"./src/app/community-activity-display.ts",
		"./src/app/community-display.ts",
		"./src/app/blog-display.ts",
		"./src/app/document-title.ts",
		"./src/app/loader-data.ts",
		"./src/app/safe-redirect.ts",
		"./src/feature-flags/registry.ts",
		"./src/feature-flags/types.ts"
	],
	"exclude": ["./client/**/*.test.ts", "./client/**/*.spec.ts"]
}
