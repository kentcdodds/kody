{
	"extends": "./tsconfig-worker-typecheck.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.worker-test.tsbuildinfo",
		"types": [
			"@pitlane/dev/assets",
			"node",
			"@cloudflare/vitest-pool-workers/types"
		]
	},
	"include": [
		"./env.d.ts",
		"./worker-configuration.d.ts",
		"./src/**/*.d.ts",
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"./universal/**/*.ts",
		"./universal/**/*.tsx",
		"../shared/src/**/*.ts",
		"../mock-servers/**/*.ts",
		"../../sentry/**/*.ts"
	],
	"exclude": []
}
