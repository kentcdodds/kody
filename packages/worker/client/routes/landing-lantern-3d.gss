/* Kody's lantern in 3D: a dark cap and base around a glowing globe, six
   primitive orbs, and a swirl of motes. landing-lantern-3d-engine.ts
   drives the orbit (--yaw), every orb's position, size, and glow,
   and the page and flame colors, so the scene itself only animates the
   motes.

   The globe is the scene background: a radial glow centered on the
   lantern's pivot, so it stays put while the lantern turns. The orbs live
   outside #body in world space and always face the camera, so their
   glyph textures stay readable from every side. */

@property --yaw { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
@property --page { syntax: "<color>"; inherits: false; initial-value: #e6e8ea; }
@property --core { syntax: "<color>"; inherits: false; initial-value: #fff1c2; }
@property --amber { syntax: "<color>"; inherits: false; initial-value: #ffb733; }
@property --sparkle { syntax: "<number>"; inherits: false; initial-value: 2.6; }

@property --memory-x { syntax: "<number>"; inherits: false; initial-value: 0; }
@property --memory-y { syntax: "<number>"; inherits: false; initial-value: 0.44; }
@property --memory-z { syntax: "<number>"; inherits: false; initial-value: 0.32; }
@property --memory-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --memory-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@property --secrets-x { syntax: "<number>"; inherits: false; initial-value: -0.44; }
@property --secrets-y { syntax: "<number>"; inherits: false; initial-value: 0.2; }
@property --secrets-z { syntax: "<number>"; inherits: false; initial-value: -0.3; }
@property --secrets-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --secrets-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@property --packages-x { syntax: "<number>"; inherits: false; initial-value: 0.44; }
@property --packages-y { syntax: "<number>"; inherits: false; initial-value: 0.2; }
@property --packages-z { syntax: "<number>"; inherits: false; initial-value: -0.3; }
@property --packages-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --packages-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@property --triggers-x { syntax: "<number>"; inherits: false; initial-value: -0.42; }
@property --triggers-y { syntax: "<number>"; inherits: false; initial-value: -0.24; }
@property --triggers-z { syntax: "<number>"; inherits: false; initial-value: 0.3; }
@property --triggers-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --triggers-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@property --integrations-x { syntax: "<number>"; inherits: false; initial-value: 0.42; }
@property --integrations-y { syntax: "<number>"; inherits: false; initial-value: -0.24; }
@property --integrations-z { syntax: "<number>"; inherits: false; initial-value: 0.3; }
@property --integrations-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --integrations-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@property --apps-x { syntax: "<number>"; inherits: false; initial-value: 0; }
@property --apps-y { syntax: "<number>"; inherits: false; initial-value: -0.42; }
@property --apps-z { syntax: "<number>"; inherits: false; initial-value: -0.3; }
@property --apps-scale { syntax: "<number>"; inherits: false; initial-value: 1; }
@property --apps-glow { syntax: "<number>"; inherits: false; initial-value: 1; }

@scene {
  group#body {
    lathe#cap;
    cylinder#cap-button;
    cylinder#cap-glow;
    path#handle;
    lathe#base;
    cylinder#plate;
    torus#seam-top;
    torus#seam-bottom;
  }
  group#glints {
    torus#glass-rim;
    group#swarm {
      sphere.mote * 18;
    }
  }
  group#memory.orb { sphere.ball; }
  group#secrets.orb { sphere.ball; }
  group#packages.orb { sphere.ball; }
  group#triggers.orb { sphere.ball; }
  group#integrations.orb { sphere.ball; }
  group#apps.orb { sphere.ball; }
  light#pool;
}

scene {
  floor: none;
  background: radial-gradient(circle closest-side at 50% 54.8%, var(--core) 0%, var(--amber) 42%, #f08a12 77%, #f6c77a 79.5%, var(--page) 100%);
  camera-angle: 0deg 10deg;
  camera-distance: 5.5;
  camera-target: 0 0.18 0;
  light: -35deg 50deg #fff4e0 0.9;
  ambient: 0.35;
}

#body {
  rotate-y: var(--yaw);
}

#cap, #handle, #base {
  color: #2b2c31;
  material: jelly(0.95);
}

#cap {
  d: polygon(0 -0.21, 0.40 -0.21, 0.44 -0.17, 0.44 -0.07, 0.60 -0.07, 0.65 -0.02, 0.65 0.16, 0.60 0.21, 0 0.21);
  translate: 0 0.91 0;
}

#cap-button {
  radius: 0.3;
  height: 0.03;
  translate: 0 1.12 0;
  color: #3a3b42;
}

/* The underside of the cap, lit by the globe below it. */
#cap-glow {
  radius: 0.6;
  height: 0.012;
  translate: 0 0.695 0;
  color: #ffbf5e;
  filter: brightness(1.3);
}

#handle {
  d: path("M-0.56 0.3 V0 A0.56 0.56 0 0 1 0.56 0 V0.3");
  stroke-width: 0.15;
  translate: 0 1.19 0;
}

#base {
  d: polygon(0 0, 0.90 0, 0.97 0.06, 0.97 0.36, 0.86 0.52, 0.72 0.58, 0 0.58);
  translate: 0 -0.99 0;
}

#plate {
  radius: 0.86;
  height: 0.02;
  translate: 0 -0.695 0;
  color: #9a6a33;
}

#seam-top, #seam-bottom {
  thickness: 0.028;
  color: #ffd27a;
}

#seam-top {
  radius: 0.63;
  translate: 0 0.7 0;
}

#seam-bottom {
  radius: 0.88;
  translate: 0 -0.7 0;
}

/* The globe's edge: a thin ring where the glass turns away from the
   camera, tilted to face it so the cap and base hide its ends. */
#glass-rim {
  radius: 0.955;
  thickness: 0.005;
  rotate-x: -78deg;
  translate: 0 0.035 0.166;
  color: #ffe6b0;
  filter: brightness(1.7);
}

/* One bloom for everything that sparkles: each bloom() is its own set of
   passes, even with the same settings. */
#glints {
  filter: bloom(1.4, 12px);
}

#swarm {
  animation: swirl 36s linear;
  filter: brightness(var(--sparkle));
}

.mote {
  radius: random(0.012, 0.024);
  translate: random(-0.65, 0.65) random(-0.55, 0.55) random(-0.55, 0.55);
  color: #fff6d8;
}

.ball {
  radius: 0.175;
  material: jelly(0.55);
}

#memory {
  translate: var(--memory-x) var(--memory-y) var(--memory-z);
  scale: var(--memory-scale);
  filter: brightness(var(--memory-glow));
}

#secrets {
  translate: var(--secrets-x) var(--secrets-y) var(--secrets-z);
  scale: var(--secrets-scale);
  filter: brightness(var(--secrets-glow));
}

#packages {
  translate: var(--packages-x) var(--packages-y) var(--packages-z);
  scale: var(--packages-scale);
  filter: brightness(var(--packages-glow));
}

#triggers {
  translate: var(--triggers-x) var(--triggers-y) var(--triggers-z);
  scale: var(--triggers-scale);
  filter: brightness(var(--triggers-glow));
}

#integrations {
  translate: var(--integrations-x) var(--integrations-y) var(--integrations-z);
  scale: var(--integrations-scale);
  filter: brightness(var(--integrations-glow));
}

#apps {
  translate: var(--apps-x) var(--apps-y) var(--apps-z);
  scale: var(--apps-scale);
  filter: brightness(var(--apps-glow));
}

#memory .ball { color: #f13b2e; }
#secrets .ball { color: #9754ed; }
#packages .ball { color: #007df3; }
#triggers .ball { color: #d6b603; }
#integrations .ball { color: #05b047; }
#apps .ball { color: #ff53c6; }

#memory .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-memory.svg"); }
#secrets .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-secrets.svg"); }
#packages .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-packages.svg"); }
#triggers .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-triggers.svg"); }
#integrations .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-integrations.svg"); }
#apps .ball::face(front) { texture: url("/images/lantern/kody-primitives-glyph-apps.svg"); }

#pool {
  translate: 0 -0.67 0;
  color: #ffb347;
  intensity: 0.2;
}

@keyframes swirl {
  to {
    rotate-y: 1turn;
  }
}
