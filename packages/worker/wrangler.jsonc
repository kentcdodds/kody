{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kody",
	"compatibility_date": "2026-04-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "./src/index.ts",
	"upload_source_maps": true,
	"migrations": [
		{
			"new_sqlite_classes": ["MCP"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["ChatAgent"],
			"tag": "v2",
		},
		{
			"new_sqlite_classes": ["HomeConnectorSession", "HomeMCP"],
			"tag": "v3",
		},
		{
			"new_sqlite_classes": ["SchedulerDO"],
			"tag": "v4",
		},
		{
			"new_sqlite_classes": ["JobManager", "JobRunner"],
			"tag": "v6",
		},
		{
			"deleted_classes": ["SchedulerDO"],
			"tag": "v7",
		},
		{
			"new_sqlite_classes": ["StorageRunner"],
			"tag": "v8",
		},
		{
			"deleted_classes": ["JobRunner"],
			"tag": "v9",
		},
		{
			"new_sqlite_classes": ["AgentTurnRunner"],
			"tag": "v10",
		},
		{
			"new_sqlite_classes": ["RepoSession"],
			"tag": "v11",
		},
		{
			"new_sqlite_classes": ["PackageRealtimeSession"],
			"tag": "v13",
		},
		{
			"new_sqlite_classes": ["PackageServiceInstance"],
			"tag": "v14",
		},
		{
			"renamed_classes": [
				{
					"from": "HomeConnectorSession",
					"to": "RemoteConnectorSession",
				},
			],
			"tag": "v15",
		},
		{
			"deleted_classes": ["HomeMCP"],
			"tag": "v16",
		},
		{
			"deleted_classes": ["ChatAgent", "AgentTurnRunner"],
			"tag": "v17",
		},
	],

	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"env": {
		"production": {
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
				{
					"binding": "APP_LOADER",
				},
			],
			"workflows": [
				{
					"binding": "DYNAMIC_CALLABLE_WORKFLOWS",
					"name": "kody-dynamic-callable-workflows",
					"class_name": "DynamicCallableWorkflow",
				},
			],
			"assets": {
				"directory": "./public",
				"binding": "ASSETS",
				"run_worker_first": [
					"/@*/api/package-invocations/*",
					"/@*/connectors/*",
					"/@*/packages/*",
					"/mcp-apps/*",
					"/styles.css",
					"/client-entry.js",
					"/assets/*",
				],
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MCP",
						"name": "MCP_OBJECT",
					},
					{
						"class_name": "RemoteConnectorSession",
						"name": "REMOTE_CONNECTOR_SESSION",
					},
					{
						"class_name": "JobManager",
						"name": "JOB_MANAGER",
					},
					{
						"class_name": "StorageRunner",
						"name": "STORAGE_RUNNER",
					},
					{
						"class_name": "RepoSession",
						"name": "REPO_SESSION",
					},
					{
						"class_name": "PackageRealtimeSession",
						"name": "PACKAGE_REALTIME_SESSION",
					},
					{
						"class_name": "PackageServiceInstance",
						"name": "PACKAGE_SERVICE_INSTANCE",
					},
				],
			},
			"d1_databases": [
				{
					"binding": "APP_DB",
					"database_name": "kody",
					"migrations_dir": "./migrations",
				},
			],
			"send_email": [
				{
					"name": "EMAIL",
				},
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
				},
				{
					"binding": "BUNDLE_ARTIFACTS_KV",
				},
			],
			"vectorize": [
				{
					"binding": "CAPABILITY_VECTOR_INDEX",
					"index_name": "kody-capabilities-prod",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "USAGE_EVENTS",
					"dataset": "kody_usage_events",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"vars": {
				"SENTRY_ENVIRONMENT": "production",
				"ARTIFACTS_NAMESPACE": "production",
				"WORKFLOW_CONCURRENT_LIMIT": "100",
			},
		},
		"preview": {
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
				{
					"binding": "APP_LOADER",
				},
			],
			"workflows": [
				{
					"binding": "DYNAMIC_CALLABLE_WORKFLOWS",
					"name": "kody-preview-dynamic-callable-workflows",
					"class_name": "DynamicCallableWorkflow",
				},
			],
			"assets": {
				"directory": "./public",
				"binding": "ASSETS",
				"run_worker_first": [
					"/@*/api/package-invocations/*",
					"/@*/connectors/*",
					"/@*/packages/*",
					"/mcp-apps/*",
					"/styles.css",
					"/client-entry.js",
					"/assets/*",
				],
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MCP",
						"name": "MCP_OBJECT",
					},
					{
						"class_name": "RemoteConnectorSession",
						"name": "REMOTE_CONNECTOR_SESSION",
					},
					{
						"class_name": "JobManager",
						"name": "JOB_MANAGER",
					},
					{
						"class_name": "StorageRunner",
						"name": "STORAGE_RUNNER",
					},
					{
						"class_name": "RepoSession",
						"name": "REPO_SESSION",
					},
					{
						"class_name": "PackageRealtimeSession",
						"name": "PACKAGE_REALTIME_SESSION",
					},
					{
						"class_name": "PackageServiceInstance",
						"name": "PACKAGE_SERVICE_INSTANCE",
					},
				],
			},
			"d1_databases": [
				{
					"binding": "APP_DB",
					"database_name": "kody-preview",
					"migrations_dir": "./migrations",
				},
			],
			"send_email": [
				{
					"name": "EMAIL",
				},
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
				},
				{
					"binding": "BUNDLE_ARTIFACTS_KV",
				},
			],
			"vectorize": [
				{
					"binding": "CAPABILITY_VECTOR_INDEX",
					"index_name": "kody-capabilities-preview",
				},
			],
			"analytics_engine_datasets": [
				{
					"binding": "USAGE_EVENTS",
					"dataset": "kody_usage_events_preview",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"vars": {
				"SENTRY_ENVIRONMENT": "preview",
				"ARTIFACTS_NAMESPACE": "preview",
				"WORKFLOW_CONCURRENT_LIMIT": "100",
			},
		},
		"test": {
			"worker_loaders": [
				{
					"binding": "LOADER",
				},
				{
					"binding": "APP_LOADER",
				},
			],
			"workflows": [
				{
					"binding": "DYNAMIC_CALLABLE_WORKFLOWS",
					"name": "kody-test-dynamic-callable-workflows",
					"class_name": "DynamicCallableWorkflow",
				},
			],
			"assets": {
				"directory": "./public",
				"binding": "ASSETS",
				"run_worker_first": [
					"/@*/api/package-invocations/*",
					"/@*/connectors/*",
					"/@*/packages/*",
					"/mcp-apps/*",
					"/styles.css",
					"/client-entry.js",
					"/assets/*",
				],
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MCP",
						"name": "MCP_OBJECT",
					},
					{
						"class_name": "RemoteConnectorSession",
						"name": "REMOTE_CONNECTOR_SESSION",
					},
					{
						"class_name": "JobManager",
						"name": "JOB_MANAGER",
					},
					{
						"class_name": "StorageRunner",
						"name": "STORAGE_RUNNER",
					},
					{
						"class_name": "RepoSession",
						"name": "REPO_SESSION",
					},
					{
						"class_name": "PackageRealtimeSession",
						"name": "PACKAGE_REALTIME_SESSION",
					},
					{
						"class_name": "PackageServiceInstance",
						"name": "PACKAGE_SERVICE_INSTANCE",
					},
				],
			},
			"d1_databases": [
				{
					"binding": "APP_DB",
					"database_name": "kody-preview",
					"migrations_dir": "./migrations",
				},
			],
			"send_email": [
				{
					"name": "EMAIL",
				},
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
				},
				{
					"binding": "BUNDLE_ARTIFACTS_KV",
				},
			],
			"vars": {
				"SENTRY_ENVIRONMENT": "test",
				"ARTIFACTS_NAMESPACE": "default",
				"WORKFLOW_CONCURRENT_LIMIT": "100",
				"COOKIE_SECRET": "LOCAL_AND_PREVIEW_COOKIE_SECRET_32_CHARS_MINIMUM",
				"SECRET_STORE_KEY": "LOCAL_TEST_SECRET_STORE_KEY_32_CHARS_MINIMUM_OK",
			},
		},
	},
}
