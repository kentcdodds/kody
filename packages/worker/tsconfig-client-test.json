{
	"extends": "./tsconfig-client.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.client-test.tsbuildinfo",
		"lib": ["DOM", "DOM.Iterable", "ES2023", "ESNext.Disposable"],
		"types": ["node"]
	},
	"include": [
		"./client/**/*.ts",
		"./client/**/*.tsx",
		"./client/**/*.d.ts",
		"./src/blog/markdown.d.ts"
	],
	"exclude": []
}
