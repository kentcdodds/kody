{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["@cloudflare/workers-types", "node"],
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"../worker/universal/highlighted-code.ts",
		"../worker/universal/highlight-cache-request.ts"
	]
}
