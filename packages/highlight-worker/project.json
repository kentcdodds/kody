{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "highlight-worker",
	"projectType": "application",
	"sourceRoot": "packages/highlight-worker/src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run highlight:build"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run highlight:deploy"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p packages/highlight-worker/tsconfig.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --project node-unit packages/highlight-worker"
			}
		}
	}
}
