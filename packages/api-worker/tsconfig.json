{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["@cloudflare/workers-types", "node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	// Tests run in the root node-unit project and lean on the main worker's
	// test support; this project only typechecks the worker sources.
	"exclude": ["src/**/*.test.ts"]
}
