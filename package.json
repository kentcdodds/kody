{
  "name": "kody",
  "private": true,
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "imports": {
    "#app/*": "./packages/worker/src/app/*",
    "#client/*": "./packages/worker/client/*",
    "#universal/*": "./packages/worker/universal/*",
    "#worker/*": "./packages/worker/src/*",
    "#*": "./*",
    "#mcp/*": "./packages/worker/src/mcp/*"
  },
  "description": "Your assistant's home — the memory, keys, code, and automations your AI agent keeps, portable across every MCP host",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,css}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "scripts": {
    "dev": "node --env-file=packages/worker/.env cli.ts",
    "dev:ensure": "node --env-file-if-exists=packages/worker/.env tools/ensure-dev.ts",
    "dev:client": "vite",
    "dev:vite": "vite",
    "clean:client": "node -e \"const{rmSync}=require('node:fs');for(const p of ['packages/worker/public/assets','packages/worker/public/client-manifest.json','dist'])rmSync(p,{recursive:true,force:true})\"",
    "dev:client:web": "vite",
    "dev:worker": "vite",
    "dev:mock-cloudflare": "node --env-file=packages/worker/.env ./wrangler-env.ts dev --local --config packages/mock-servers/cloudflare/wrangler.jsonc",
    "deploy": "node --input-type=module -e \"if (['preview','test'].includes(process.env.CLOUDFLARE_ENV ?? '')) { await import('./tools/prepare-e2e-env.ts'); }\" && node --env-file=packages/worker/.env tools/deploy.ts --outdir .wrangler/sentry-bundle --upload-source-maps",
    "sentry:upload-sourcemaps": "node tools/sentry-upload-sourcemaps.ts",
    "build:client:web": "vite build",
    "build:client": "vite build",
    "build": "vite build",
    "backup:build": "wrangler deploy --dry-run --config packages/backup-control-plane/wrangler.jsonc",
    "backup:deploy": "wrangler deploy --config packages/backup-control-plane/wrangler.jsonc",
    "status:build": "wrangler deploy --dry-run --config packages/status/wrangler.jsonc",
    "status:deploy": "wrangler deploy --config packages/status/wrangler.jsonc",
    "nx-cache:build": "wrangler deploy --dry-run --config packages/nx-cache/wrangler.jsonc",
    "nx-cache:deploy": "wrangler deploy --config packages/nx-cache/wrangler.jsonc",
    "nx-cache:smoke": "node tools/nx-remote-cache-smoke.ts",
    "runtime:build": "node ./wrangler-env.ts deploy --dry-run --outdir .wrangler/runtime-dry-run --config packages/runtime-worker/wrangler.jsonc",
    "platform:build": "node ./wrangler-env.ts deploy --dry-run --outdir .wrangler/platform-dry-run --config packages/platform-worker/wrangler.jsonc",
    "jobs:build": "wrangler deploy --dry-run --outdir .tmp/jobs-worker-build --config packages/jobs-worker/wrangler.jsonc --env production",
    "jobs:deploy": "wrangler deploy --config packages/jobs-worker/wrangler.jsonc --env production",
    "highlight:build": "wrangler deploy --dry-run --outdir .tmp/highlight-worker-build --config packages/highlight-worker/wrangler.jsonc --env production",
    "highlight:deploy": "wrangler deploy --config packages/highlight-worker/wrangler.jsonc --env production",
    "backup:readiness": "node tools/disaster-recovery/canonical-readiness-cli.ts",
    "backup:resources": "node tools/ci/backup-resources-cli.ts",
    "backup:restore-drill": "node tools/disaster-recovery/d1-restore-drill-cli.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "primitives:check": "node .agents/skills/visual-recap/scripts/check-primitives-map.mjs",
    "primitives:classify": "node .agents/skills/visual-recap/scripts/classify-primitives.mjs",
    "docs:check-temporal": "node tools/check-docs-temporal-language.ts",
    "docs:check-decisions": "node tools/check-decision-record-numbers.ts",
    "mermaid:check": "node tools/check-mermaid-syntax.ts",
    "file-size-ratchet:check": "node tools/check-file-size-ratchet.ts",
    "decorative-banners:check": "node tools/check-decorative-banners.ts",
    "slop-ratchet:check": "node tools/check-file-size-ratchet.ts && node tools/check-decorative-banners.ts",
    "knip": "knip",
    "deploy-guardrails:check": "node tools/check-deploy-guardrails.ts",
    "origin-production-exports:check": "node tools/check-origin-production-exports.ts",
    "worker-startup-bundles:check": "node tools/check-worker-startup-bundles.ts",
    "worker-startup-time:check": "node tools/check-worker-startup-time.ts",
    "migrations:check": "node tools/check-migrations.ts",
    "migrate:local": "node tools/apply-local-app-migrations.ts && node --env-file=packages/worker/.env ./wrangler-env.ts d1 migrations apply AUDIT_DB --local && node --env-file=packages/worker/.env ./wrangler-env.ts d1 migrations apply JOBS_DB --local --config packages/jobs-worker/wrangler.jsonc",
    "migrate:e2e": "node tools/apply-local-app-migrations.ts --persist-to .wrangler/state/e2e && node --env-file=packages/worker/.env ./wrangler-env.ts d1 migrations apply AUDIT_DB --local --persist-to .wrangler/state/e2e && node --env-file=packages/worker/.env ./wrangler-env.ts d1 migrations apply JOBS_DB --local --config packages/jobs-worker/wrangler.jsonc --persist-to .wrangler/state/e2e",
    "preview": "npm run migrate:local && npm run dev:vite",
    "e2e:web-server": "node tools/e2e-web-server.ts",
    "preview:e2e": "node tools/prepare-e2e-env.ts && npm run migrate:e2e && WRANGLER_PERSIST_TO=.wrangler/state/e2e npm run dev:vite",
    "preview:manual-test": "node tools/preview-manual-test.ts",
    "control-kody": "node tools/control-kody.ts",
    "site-perf": "node tools/site-perf/collect.ts",
    "generate-types": "node --env-file=packages/worker/.env ./wrangler-env.ts types ./packages/worker/worker-configuration.d.ts",
    "typecheck": "nx run worker:typecheck && tsc --noEmit -p packages/backup-control-plane/tsconfig.json && tsc --noEmit -p packages/status/tsconfig.json && tsc --noEmit -p packages/jobs-worker/tsconfig.json && tsc --noEmit -p packages/highlight-worker/tsconfig.json && tsc --noEmit -p packages/nx-cache/tsconfig.json",
    "test": "nx run worker:test",
    "test:node": "nx run worker:test-node",
    "test:workers": "nx run worker:test-workers",
    "test:push": "CI=1 npm run test:node && CI=1 npm run test:workers",
    "inspect": "npx -y @mcpjam/inspector inspector",
    "prevalidate": "node tools/build-worker-bundler-modules.ts && node tools/build-guide-catalog-modules.ts",
    "validate": "concurrently -n format,lint,typecheck,test-node,test-workers,e2e,mcp,backup-build,status-build,nx-cache-build,jobs-build,highlight-build,runtime-build,platform-build,startup,primitives,migrations,deploy-guardrails,origin-production-exports,docs-temporal,docs-decisions,mermaid,slop-ratchet,knip -c green,yellow,magenta,blue,cyan,red,blueBright,yellowBright,cyanBright,cyan,white,gray,redBright,greenBright,magentaBright,whiteBright,black,white,gray,white,cyan,yellow,magenta,blue \"npm run format:check\" \"npm run lint\" \"npm run typecheck\" \"CI=1 npm run test:node\" \"CI=1 npm run test:workers\" \"CI=1 npm run test:e2e:run\" \"CI=1 npm run test:mcp\" \"npm run backup:build\" \"npm run status:build\" \"npm run nx-cache:build\" \"npm run jobs:build\" \"npm run highlight:build\" \"npm run runtime:build\" \"npm run platform:build\" \"npm run worker-startup-bundles:check && npm run worker-startup-time:check\" \"npm run primitives:check\" \"npm run migrations:check\" \"npm run deploy-guardrails:check\" \"npm run origin-production-exports:check\" \"npm run docs:check-temporal\" \"npm run docs:check-decisions\" \"npm run mermaid:check\" \"npm run slop-ratchet:check\" \"npm run knip\"",
    "validate:fix": "npm run format && npm run lint:fix",
    "test:e2e:ensure": "node tools/ensure-playwright-browser.ts",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:run": "nx run worker:test-e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium --with-deps",
    "test:mcp": "nx run worker:test-mcp",
    "hooks:ensure": "node tools/ensure-cloud-agent-hooks.ts",
    "prepare": "husky && node tools/ensure-cloud-agent-hooks.ts && node tools/patch-wrangler-proxy-worker-errors.ts",
    "nx:graph": "nx graph",
    "nx:show-projects": "nx show projects",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@epic-web/config": "^3.2.1",
    "@kody-internal/shared": "file:packages/shared",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pitlane/dev": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.7.0",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "get-port": "^7.2.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "mermaid": "^11.17.2",
    "msw": "^2.15.0",
    "nx": "^23.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "set-cookie-parser": "^3.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "brace-expansion": "^5.0.9",
    "hono": ">=4.12.27 <5.0.0",
    "@hono/node-server": ">=2.0.10 <3.0.0",
    "postcss": ">=8.5.10 <9.0.0",
    "isomorphic-git": ">=1.40.0 <1.40.8"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.11.1",
  "workspaces": [
    "packages/backup-control-plane",
    "packages/jobs-worker",
    "packages/highlight-worker",
    "packages/shared",
    "packages/status",
    "packages/nx-cache",
    "packages/worker",
    "packages/mock-servers/*"
  ],
  "allowScripts": {
    "@sentry/cli": true,
    "core-js-pure": true,
    "esbuild": true,
    "fsevents": true,
    "msw": true,
    "nx": true,
    "sharp": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
